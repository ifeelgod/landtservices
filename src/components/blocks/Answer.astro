---
import type { Block } from '../../content/types';
import Section from './Section.astro';

type Answer = Extract<Block, { type: 'answer' }>;
interface Props { block: Answer; idx: number }
const { block: b, idx } = Astro.props;
---
<Section bg={b.bg} labelledby={`h-${idx}`}>
  <div class="answer">
    <h2 id={`h-${idx}`}>{b.question}</h2>
    <p class="answer__text" set:html={b.answer} />
  </div>
</Section>

<style>
  .answer {
    max-width: 880px; position: relative; padding: clamp(1.5rem, 4vw, 2.5rem); padding-left: clamp(1.75rem, 4vw, 2.75rem);
    background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);
  }
  .answer::before { content: ''; position: absolute; left: 0; top: 1.5rem; bottom: 1.5rem; width: 5px; border-radius: 0 6px 6px 0; background: linear-gradient(var(--purple-700), var(--pink-500)); }
  .answer h2 { font-size: clamp(1.35rem, 2.4vw, 1.85rem); }
  .answer__text { font-size: 1.12rem; color: var(--ink-soft); margin: 0; }
</style>
