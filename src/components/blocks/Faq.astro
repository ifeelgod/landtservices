---
import type { Block } from '../../content/types';
import Section from './Section.astro';

type Faq = Extract<Block, { type: 'faq' }>;
interface Props { block: Faq; idx: number }
const { block: b, idx } = Astro.props;
---
<Section bg={b.bg} labelledby={`h-${idx}`}>
  <div class="faq">
    <div class="section-head"><h2 id={`h-${idx}`}>{b.title}</h2></div>
    <div class="faq__list">
      {b.items.map((f, i) => (
        <details class="faq__item" open={i === 0}>
          <summary><h3>{f.q}</h3><span class="faq__icon" aria-hidden="true"></span></summary>
          <div class="faq__a"><p set:html={f.a} /></div>
        </details>
      ))}
    </div>
  </div>
</Section>

<style>
  .faq { max-width: 880px; }
  .faq__list { display: grid; gap: 0.75rem; }
  .faq__item { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); }
  .faq__item[open] { border-color: #c4b5fd; }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.35rem; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-size: 1.06rem; }
  .faq__icon { position: relative; flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--lavender-50); }
  .faq__icon::before, .faq__icon::after { content: ''; position: absolute; left: 8px; right: 8px; top: 13px; height: 2px; background: var(--purple-700); border-radius: 2px; transition: transform 0.2s; }
  .faq__icon::after { transform: rotate(90deg); }
  [open] .faq__icon::after { transform: rotate(0); }
  .faq__a { padding: 0 1.35rem 1.2rem; color: var(--ink-soft); }
  .faq__a p { margin: 0; }
</style>
