---
import { Image } from 'astro:assets';
import type { Block } from '../../content/types';
import type { Lang } from '../../i18n/routes';
import { resolveHref } from '../../lib/links';
import { IMAGES } from '../../lib/images';
import TrustBadges from './TrustBadges.astro';
import Icon from '../Icon.astro';

type Hero = Extract<Block, { type: 'hero' }>;
interface Props { block: Hero; lang: Lang }
const { block: b, lang } = Astro.props;
const img = b.image ? IMAGES[b.image] : null;
---
<section class:list={['hero', { 'hero--noimg': !img }]}>
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      {b.eyebrow && <span class="eyebrow">{b.eyebrow}</span>}
      <h1 set:html={b.title} />
      <p class="hero__sub" set:html={b.subtitle} />
      {b.points && (
        <ul class="hero__points">
          {b.points.map((p) => <li><Icon name="check" size={18} /><span set:html={p} /></li>)}
        </ul>
      )}
      {(b.primary || b.secondary) && (
        <div class="btn-row hero__ctas">
          {b.primary && <a class="btn btn--primary" href={resolveHref(b.primary.href, lang)}>{b.primary.label}</a>}
          {b.secondary && (
            <a class="btn btn--outline" href={resolveHref(b.secondary.href, lang)}>
              {(b.secondary.href === 'tel' || b.secondary.href === 'emergency') && <Icon name="phone" />}
              {b.secondary.label}
            </a>
          )}
        </div>
      )}
      {b.badges && <div class="hero__badges"><TrustBadges lang={lang} /></div>}
    </div>
    {img && (
      <div class="hero__media">
        <Image src={img} alt={b.imageAlt ?? ''} widths={[480, 720, 960]} sizes="(min-width: 1000px) 540px, 100vw" loading="eager" fetchpriority="high" format="webp" quality={72} />
        <div class="hero__float" aria-hidden="true">
          <Icon name="clock" size={22} />
          <span><strong>24/7</strong>{lang === 'es' ? ' Servicio móvil' : ' Mobile dispatch'}</span>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 5.5rem); }
  .hero__bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(60% 70% at 100% 0%, rgb(236 72 153 / 0.16), transparent 60%),
      radial-gradient(50% 60% at 0% 100%, rgb(139 92 246 / 0.16), transparent 60%),
      linear-gradient(180deg, var(--lavender-50), #fff 85%);
  }
  .hero__grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 1000px) { .hero__grid { grid-template-columns: 1.08fr 0.92fr; gap: 3.5rem; } }
  .hero--noimg .hero__grid { grid-template-columns: 1fr; max-width: 900px; }
  .hero h1 { margin-bottom: 0.45em; }
  .hero h1 :global(em) { font-style: normal; background: linear-gradient(90deg, var(--purple-700), var(--pink-600)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero__sub { font-size: clamp(1.05rem, 1.6vw, 1.22rem); color: var(--ink-soft); max-width: 60ch; }
  .hero__points { list-style: none; padding: 0; margin: 0 0 1.6rem; display: grid; gap: 0.5rem; }
  .hero__points li { display: flex; gap: 0.55rem; align-items: flex-start; font-weight: 600; }
  .hero__points :global(svg) { flex: none; margin-top: 3px; color: #fff; background: var(--purple-700); border-radius: 50%; padding: 3px; width: 22px; height: 22px; }
  .hero__ctas { margin-top: 0.5rem; }
  .hero__badges { margin-top: 1.75rem; }
  .hero__media { position: relative; }
  .hero__media :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg); box-shadow: 0 30px 60px -20px rgb(46 10 99 / 0.35); }
  .hero__media::before { content: ''; position: absolute; inset: -14px -14px 14px 14px; border-radius: var(--radius-lg); background: linear-gradient(135deg, var(--purple-700), var(--pink-500)); z-index: -1; opacity: 0.9; }
  .hero__float {
    position: absolute; left: -12px; bottom: 22px; display: flex; gap: 0.55rem; align-items: center;
    background: #fff; padding: 0.75rem 1rem; border-radius: 14px; box-shadow: var(--shadow); font-size: 0.95rem; color: var(--ink);
  }
  .hero__float :global(svg) { color: var(--pink-600); }
  .hero__float strong { color: var(--purple-700); }
</style>
