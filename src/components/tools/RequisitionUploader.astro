---
import type { Lang } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
---
<div class="req-uploader" data-req-uploader>
  <div class="req-uploader__head">
    <span class="eyebrow">{es ? 'Herramienta de Carga y Firma' : 'Digital Requisition & Consent'}</span>
    <h2>{es ? 'Carga Segura de Orden Médica y Firma Digital' : 'Secure Doctor Requisition Uploader & Digital Signature Pad'}</h2>
    <p>{es ? 'Tome una foto de su orden médica o suba el archivo PDF, y firme digitalmente su consentimiento antes de su cita.' : 'Take a photo of your physician lab requisition or upload a PDF, then digitally sign your patient consent form right on your screen.'}</p>
  </div>

  <div class="req-grid">
    <!-- Dropzone -->
    <div class="req-box">
      <h3>1. {es ? 'Subir Orden Médica (Foto o PDF)' : 'Upload Physician Requisition (Photo / PDF)'}</h3>
      <div class="dropzone" data-dropzone>
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
        <p><strong>{es ? 'Toque aquí para tomar foto o elegir archivo' : 'Tap to take photo or choose file'}</strong></p>
        <span class="drop-info">{es ? 'JPG, PNG, PDF (máx. 10 MB)' : 'JPG, PNG, PDF (Max 10MB)'}</span>
        <input type="file" accept="image/*,application/pdf" data-file-input class="sr-only" id="req-file" />
      </div>
      <div class="file-preview hidden" data-file-preview>
        <span>📄 <strong data-file-name>requisition.pdf</strong></span>
        <button type="button" class="btn-text" data-remove-file>{es ? 'Quitar' : 'Remove'}</button>
      </div>
    </div>

    <!-- Signature Pad -->
    <div class="req-box">
      <h3>2. {es ? 'Firma Digital de Consentimiento' : 'Digital Patient Consent Signature'}</h3>
      <p class="sig-note">{es ? 'Firme dentro del cuadro usando su dedo o ratón:' : 'Draw your signature inside the box using your finger or mouse:'}</p>
      <div class="sig-wrap">
        <canvas class="sig-canvas" data-sig-canvas width="360" height="130"></canvas>
        <button type="button" class="btn-clear" data-clear-sig>{es ? 'Borrar Firma' : 'Clear Signature'}</button>
      </div>
    </div>
  </div>

  <div class="req-foot">
    <p class="form-note">🔒 {es ? 'Encriptación bancaria SSL. Sus datos nunca se comparten sin su autorización.' : 'Bank-grade SSL encryption. Your documents are transmitted securely per HIPAA guidelines.'}</p>
  </div>
</div>

<script>
  const wrap = document.querySelector('[data-req-uploader]');
  if (wrap) {
    // Dropzone logic
    const dropzone = wrap.querySelector<HTMLElement>('[data-dropzone]');
    const fileInput = wrap.querySelector<HTMLInputElement>('[data-file-input]');
    const preview = wrap.querySelector<HTMLElement>('[data-file-preview]');
    const fileName = wrap.querySelector<HTMLElement>('[data-file-name]');
    const removeBtn = wrap.querySelector<HTMLButtonElement>('[data-remove-file]');

    dropzone?.addEventListener('click', () => fileInput?.click());
    fileInput?.addEventListener('change', () => {
      if (fileInput.files && fileInput.files[0]) {
        if (fileName) fileName.textContent = fileInput.files[0].name;
        dropzone?.classList.add('hidden');
        preview?.classList.remove('hidden');
      }
    });
    removeBtn?.addEventListener('click', () => {
      if (fileInput) fileInput.value = '';
      dropzone?.classList.remove('hidden');
      preview?.classList.add('hidden');
    });

    // Signature Canvas logic
    const canvas = wrap.querySelector<HTMLCanvasElement>('[data-sig-canvas]');
    const clearBtn = wrap.querySelector<HTMLButtonElement>('[data-clear-sig]');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      let drawing = false;

      const getPos = (e: MouseEvent | TouchEvent) => {
        const rect = canvas.getBoundingClientRect();
        const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
        const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
        return { x: clientX - rect.left, y: clientY - rect.top };
      };

      const startDraw = (e: MouseEvent | TouchEvent) => {
        drawing = true;
        const { x, y } = getPos(e);
        if (ctx) {
          ctx.beginPath();
          ctx.moveTo(x, y);
          ctx.strokeStyle = '#5B21B6';
          ctx.lineWidth = 2.5;
          ctx.lineCap = 'round';
        }
      };

      const draw = (e: MouseEvent | TouchEvent) => {
        if (!drawing || !ctx) return;
        e.preventDefault();
        const { x, y } = getPos(e);
        ctx.lineTo(x, y);
        ctx.stroke();
      };

      const stopDraw = () => { drawing = false; };

      canvas.addEventListener('mousedown', startDraw);
      canvas.addEventListener('mousemove', draw);
      canvas.addEventListener('mouseup', stopDraw);
      canvas.addEventListener('mouseleave', stopDraw);

      canvas.addEventListener('touchstart', startDraw, { passive: false });
      canvas.addEventListener('touchmove', draw, { passive: false });
      canvas.addEventListener('touchend', stopDraw);

      clearBtn?.addEventListener('click', () => {
        if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);
      });
    }
  }
</script>

<style>
  .req-uploader { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: clamp(1.5rem, 4vw, 2.5rem); box-shadow: var(--shadow); }
  .req-uploader__head { margin-bottom: 1.5rem; }
  .req-grid { display: grid; gap: 1.5rem; }
  @media (min-width: 800px) { .req-grid { grid-template-columns: 1fr 1fr; } }
  .req-box { background: var(--lavender-50); border: 1px solid #c4b5fd; border-radius: var(--radius); padding: 1.25rem; display: flex; flex-direction: column; }
  .req-box h3 { margin: 0 0 0.6rem; font-size: 1.1rem; color: var(--purple-900); }
  .dropzone {
    border: 2px dashed var(--purple-500); border-radius: var(--radius-sm); background: #fff;
    padding: 1.5rem 1rem; text-align: center; cursor: pointer; transition: background 0.2s;
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
  }
  .dropzone:hover { background: #fdf8ff; }
  .dropzone svg { color: var(--purple-700); }
  .dropzone.hidden, .file-preview.hidden { display: none; }
  .drop-info { font-size: 0.8rem; color: var(--muted); }
  .file-preview { display: flex; align-items: center; justify-content: space-between; background: #fff; padding: 0.9rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--line); }
  .btn-text { background: none; border: 0; color: var(--pink-700); font-weight: 700; cursor: pointer; }
  .sig-note { font-size: 0.88rem; color: var(--muted); margin: 0 0 0.5rem; }
  .sig-wrap { position: relative; width: 100%; }
  .sig-canvas { background: #fff; border: 1.5px solid #cbbfe3; border-radius: var(--radius-sm); width: 100%; height: 130px; touch-action: none; cursor: crosshair; }
  .btn-clear { position: absolute; right: 8px; bottom: 8px; font-size: 0.75rem; font-weight: 700; background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 4px; padding: 0.2rem 0.5rem; cursor: pointer; }
  .req-foot { margin-top: 1.25rem; }
</style>
